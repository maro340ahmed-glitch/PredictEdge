
{
  "name": "MAX6675 Type-K Thermocouple (simulation)",
  "author": "PredictEdge",
  "pins": [
    "VCC",
    "GND",
    "SCK",
    "CS",
    "SO"
  ],
  "controls": [
    {
      "id": "temperature",
      "label": "Thermocouple temperature (C)",
      "type": "range",
      "min": 0,
      "max": 500,
      "step": 0.25
    },
    {
      "id": "openCircuit",
      "label": "Thermocouple disconnected (0/1)",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 1
    }
  ]
}
